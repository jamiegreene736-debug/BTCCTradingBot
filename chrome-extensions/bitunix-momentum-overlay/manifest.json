{
  "manifest_version": 3,
  "name": "Bitunix Intraday Signals",
  "version": "1.1.0",
  "description": "Long and short entry, hold and exit alerts for intraday trades up to 12–24 hours. No automatic orders.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://*.bitunix.com/*",
    "https://*.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.bitunix.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Bitunix Intraday Signals — settings",
    "default_popup": "popup.html"
  }
}
